global:
  env:
    - name: AUTHENTIK_HOST
      value: https://{{ domain }}
  # Pinned SSO credentials for the platform blueprint's !Env references
  # (Secret is applied by the CLI before this chart — Layer 1, not in git).
  envFrom:
    - secretRef:
        name: authentik-pinned-clients

# Declarative platform wiring (providers, groups, mappings, tiles, akadmin).
# The ConfigMap is applied by the CLI before this chart and git-owned after
# seeding; the worker discovers and applies every *.yaml key in it.
blueprints:
  configMaps:
    - authentik-blueprints

authentik:
  secret_key: {{ secret_key }}
  bootstrap_password: {{ admin_password }}
  bootstrap_email: {{ admin_email }}
  bootstrap_token: {{ bootstrap_token }}
  postgresql:
    password: {{ db_password }}

server:
  ingress:
    enabled: true
    ingressClassName: traefik
    annotations:
      cert-manager.io/cluster-issuer: {{ cluster_issuer }}
      traefik.ingress.kubernetes.io/router.entrypoints: websecure
      traefik.ingress.kubernetes.io/router.tls: "true"
    hosts:
      - {{ domain }}
    tls:
      - secretName: authentik-tls
        hosts:
          - {{ domain }}

postgresql:
  enabled: true
  auth:
    password: {{ db_password }}
    database: authentik
    username: authentik

redis:
  enabled: true
